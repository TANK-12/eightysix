  "reverbs": {
    "_about": "Reverb characters for reverb zones (lane B4). The Effects bus has one reverb; while the listener is inside a map's reverb zone (maps.json reverb_zones) it blends toward that zone's entry, wet scaled by the zone's amount. Fields: room_size, damping, spread, wet, predelay_ms, predelay_feedback, hipass (AudioEffectReverb).",
    "valley": {
      "room_size": 0.9,
      "damping": 0.7,
      "spread": 1.0,
      "wet": 0.3,
      "predelay_ms": 120,
      "predelay_feedback": 0.25,
      "hipass": 0.05
    },
    "town": {
      "room_size": 0.5,
      "damping": 0.45,
      "spread": 0.8,
      "wet": 0.45,
      "predelay_ms": 35,
