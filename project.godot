; Engine configuration file.
; Eighty Six 0.1 alpha. Registries live in data/*.json; see DEVLOG.md.

config_version=5

[application]

config/name="Eighty Six"
config/description="A Juggernaut walker game: rough ground, procedural legs, basic Legion AI."
config/version="0.1.1-alpha"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0196, 0.0314, 0.0471, 1)
boot_splash/show_image=false

[autoload]

Registry="*res://scripts/core/registry.gd"
Settings="*res://scripts/core/settings.gd"
Controls="*res://scripts/core/controls.gd"
UiTheme="*res://scripts/core/ui_theme.gd"
Graphics="*res://scripts/core/graphics.gd"
AudioMix="*res://scripts/audio/audio_mix.gd"
Sfx="*res://scripts/audio/sfx.gd"
Music="*res://scripts/audio/music.gd"
Rumble="*res://scripts/core/rumble.gd"
Game="*res://scripts/core/game.gd"
Bot="*res://scripts/core/bot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="mech_body"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_physics/layer_5="debris"
3d_physics/layer_6="trigger"
3d_physics/layer_7="grapple_surface"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.0196, 0.0314, 0.0471, 1)
anti_aliasing/quality/use_debanding=true
