{
  "about": "Clean copies: a git repo built from one or more folders with every secret, personal detail and model file left out, safe to browse and to push to a public GitHub repo. Read by clean.py. To leave something else out, add a pattern here. Each pattern runs only on content holding one of its 'needs' strings (fast); personal patterns run on text files only. A file name is checked like content, and a text file repeating a 60+ character line of a 'private_texts' note is left out too.",
  "copies": [
    {
      "name": "Forge-clean.git",
      "branch": "main",
      "items": [
        {
          "from": "/home/ejb/Forge",
          "to": ""
        },
        {
          "from": "/home/ejb/Pictures/Wallpapers",
          "to": "wallpapers"
        }
      ],
      "remote": "git@github.com:TANK-12/eightysix.git",
      "remote_branch": "forge",
      "protect": [
        "master",
        "main"
      ]
    }
  ],
  "max_file_mb": 95,
  "max_gz_mb": 200,
  "leave_out": {
    "paths": [
      "apps/ai-studio/models/",
      "apps/ai-studio/bin/",
      "apps/ai-studio/outputs/",
      "apps/code/data/",
      "models/",
      "outputs/",
      "backups/",
      "hub/status.js",
      "hub/status.json",
      "docs/library/emerson/",
      "docs/library/Notes/",
      "docs/library/money/",
      "docs/library/learning/",
      "apps/study-companion/data/",
      "apps/driftpeaks/music/"
    ],
    "names": [
      ".env",
      ".env.*",
      "*.env",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.jks",
      "*.keystore",
      "*.kdbx",
      "id_rsa*",
      "id_dsa*",
      "id_ecdsa*",
      "id_ed25519*",
      ".netrc",
      ".pgpass",
      ".git-credentials",
      ".npmrc",
      ".pypirc",
      "*credential*",
      "*secret*",
      "*password*",
      "*passwd*",
      "*cookie*",
      "key4.db",
      "logins.json",
      "login.keyring",
      "*.keyring",
      "connection-token",
      "*token.json",
      "*tokens.json",
      "auth.json",
      "*sudo*",
      "*.sqlite",
      "*.sqlite3",
      "*.db",
      "*.db-wal",
      "*.db-shm",
      "*.log",
      "transcripts",
      "*.jsonl.gz",
      "*.zip",
      "*.cbz",
      "*.7z",
      "*.rar",
      "*.tar",
      "*.tgz",
      "*.xz",
      "*.zst",
      ".envrc",
      "env.local",
      "login data",
      "web data",
      "*.docx",
      "*.xlsx",
      "*.pptx",
      "*.odt",
      "*.ods",
      "*.bz2",
      "*.jar",
      "*.apk"
    ],
    "models": [
      "*.safetensors",
      "*.ckpt",
      "*.gguf",
      "*.ggml",
      "*.onnx",
      "*.pth",
      "*.pt",
      "*.bin.index.json",
      "*.mlmodel",
      "*.tflite",
      "*.param",
      "*.engine"
    ]
  },
  "secret_patterns": [
    {
      "name": "Anthropic key",
      "re": "sk-ant-[A-Za-z0-9_\\-]{20,}",
      "needs": [
        "sk-ant-"
      ]
    },
    {
      "name": "OpenAI key",
      "re": "\\bsk-(?:proj-)?[A-Za-z0-9]{32,}",
      "needs": [
        "sk-"
      ]
    },
    {
      "name": "OpenAI or OpenRouter key",
      "re": "\\bsk-(?:or-v1|proj|svcacct|admin)-[A-Za-z0-9_\\-]{20,}",
      "needs": [
        "sk-"
      ]
    },
    {
      "name": "GitHub token",
      "re": "\\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{40,})",
      "needs": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_",
        "github_pat_"
      ]
    },
    {
      "name": "Hugging Face token",
      "re": "\\bhf_[A-Za-z0-9]{30,}",
      "needs": [
        "hf_"
      ]
    },
    {
      "name": "AWS key",
      "re": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "needs": [
        "AKIA",
        "ASIA"
      ]
    },
    {
      "name": "Google key",
      "re": "\\bAIza[0-9A-Za-z_\\-]{35}",
      "needs": [
        "AIza"
      ]
    },
    {
      "name": "Google OAuth token",
      "re": "\\bya29\\.[0-9A-Za-z_\\-]{20,}",
      "needs": [
        "ya29."
      ]
    },
    {
      "name": "Slack token",
      "re": "\\bxox[abposr]-[A-Za-z0-9\\-]{10,}",
      "needs": [
        "xox"
      ]
    },
    {
      "name": "Telegram bot token",
      "re": "\\b[0-9]{8,10}:AA[A-Za-z0-9_\\-]{33}\\b",
      "needs": [
        ":AA"
      ]
    },
    {
      "name": "Stripe key",
      "re": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}",
      "needs": [
        "_live_"
      ]
    },
    {
      "name": "private key",
      "re": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----",
      "needs": [
        "PRIVATE KEY"
      ]
    },
    {
      "name": "JSON web token",
      "re": "\\beyJ[A-Za-z0-9_\\-]{15,}\\.eyJ[A-Za-z0-9_\\-]{15,}\\.[A-Za-z0-9_\\-]{15,}",
      "needs": [
        "eyJ"
      ]
    },
    {
      "name": "password in a link",
      "re": "[a-z][a-z0-9+.\\-]*://[^/\\s:@\"'<>]{1,64}:[^/\\s:@\"'<>]{3,64}@[A-Za-z0-9.\\-]+",
      "needs": [
        "://"
      ]
    },
    {
      "name": "bearer token",
      "re": "(?i)\\bbearer\\s+[A-Za-z0-9._~+/\\-]{24,}=*",
      "needs": [
        "bearer"
      ]
    },
    {
      "name": "key or password written in a setting",
      "re": "(?i)(?:api[_\\-]?key|secret|token|passw(?:or)?d|pwd)[\"']?\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-+/=.]{16,}[\"']",
      "needs": [
        "key",
        "secret",
        "token",
        "passw",
        "pwd"
      ]
    }
  ],
  "known_secrets": [
    "/home/ejb/.local/share/forge/relay/secrets",
    "/home/ejb/.claude/.credentials.json",
    "/home/ejb/.ssh/id_ed25519",
    "/home/ejb/Forge/apps/code/data/connection-token",
    "/home/ejb/.local/share/forge/relay/settings.json",
    "/home/ejb/.gitconfig"
  ],
  "max_push_mb": 1500,
  "personal_patterns": [
    {
      "name": "personal email address",
      "re": "(?i)[a-z0-9._%+\\-]+@(?:gmail|googlemail|outlook|hotmail|live|msn|yahoo|icloud|me|proton|protonmail|aol|gmx)\\.[a-z.]{2,6}\\b",
      "needs": [
        "@"
      ]
    },
    {
      "name": "WhatsApp number",
      "re": "\\b[0-9]{8,15}@(?:s\\.whatsapp\\.net|c\\.us|g\\.us|lid)\\b",
      "needs": [
        "@"
      ]
    },
    {
      "name": "phone number",
      "re": "(?<![\\w+])\\+[1-9][0-9]{0,2}[ \\-]?\\(?[0-9]{2,5}\\)?[ \\-]?[0-9]{3,4}[ \\-]?[0-9]{3,4}(?![\\w])",
      "needs": [
        "+"
      ]
    },
    {
      "name": "Australian phone number",
      "re": "(?<![\\w.])(?:\\+?61[ \\-]?4|04)[0-9]{2}[ \\-]?[0-9]{3}[ \\-]?[0-9]{3}(?![\\w.])|\\(0[2378]\\)[ \\-]?[0-9]{4}[ \\-]?[0-9]{4}",
      "needs": [
        "04",
        "61",
        "(0"
      ]
    }
  ],
  "personal_strings_file": "/home/ejb/.config/forge-backup/personal.txt",
  "private_texts": [
    "/home/ejb/.claude/self",
    "/home/ejb/.claude/projects/*/memory",
    "/home/ejb/.claude/plans",
    "/home/ejb/.claude/CLAUDE.md"
  ]
}
