// Lets ejb start Forge backups without a password (forge-backup now / the Forge app).
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "ejb") {
    var unit = action.lookup("unit");
    if (unit && /^forge-backup-(now|auto)@(all|rescue|vault)\.service$/.test(unit) &&
        action.lookup("verb") == "start") {
      return polkit.Result.YES;
    }
  }
});
