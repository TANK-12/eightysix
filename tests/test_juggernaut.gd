extends "res://tests/lib/test_case.gd"
## The real Juggernaut Model 2 (lane B1's export, data/mechs.json juggernaut_m2 generated by
## tools/build_juggernaut_data.py): real mass and legs, the real skinned mesh wired onto lane A1's
## gait and physics, standing and walking on Jolt without falling through the ground.
## tools/run_tests.sh passes --fixed-fps 120, so 120 physics frames are exactly 1 s of game time.

var ground: StaticBody3D
var mech: RigidBody3D


func before_each() -> void:
	ground = StaticBody3D.new()
	var cs := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(400, 2, 400)
	cs.shape = box
	cs.position.y = -1.0
	ground.add_child(cs)
	tree.root.add_child(ground)
	mech = MechBuilder.build("juggernaut_m2")
	mech.position = Vector3(0, 3.0, 0)
	tree.root.add_child(mech)


func after_each() -> void:
	for a: String in ["move_forward", "jump", "strafe_right", "brake", "turn_right", "sprint"]:
		Input.action_release(a)
	mech.free()
	ground.free()
	Settings.reset_all_quietly()


func test_builds_with_the_real_mass() -> void:
	var def := Registry.entry("mechs", "juggernaut_m2")
	assert_eq(str(def.get("status", "")), "ready")
	var model: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://assets/models/juggernaut/juggernaut_mk2.json"))
	assert_true(model is Dictionary, "the synced export json parses")
	assert_almost_eq(mech.mass, float((model as Dictionary)["total_mass_kg"]), 1.0, "matches B1's export total exactly (every real part's mass_kg, none dropped or doubled)")
	assert_between(mech.mass, 11000.0, 13000.0, "about the Juggernaut's 12.2 t placeholder mass")
	assert_almost_eq(mech.center_of_mass.x, 0.0, 0.05, "left-right symmetric")


func test_real_mesh_replaces_the_placeholder_boxes() -> void:
	var real_legs: Dictionary = mech.get("_real_mesh")
	assert_eq(real_legs.size(), 4, "all four legs got a real mesh")
	for leg_name: String in ["fr", "fl", "rr", "rl"]:
		assert_true(real_legs.has(leg_name))
		var m: Dictionary = real_legs[leg_name]
		for seg: String in ["upper", "lower", "foot"]:
			assert_true((m[seg] as Node3D).visible, "%s %s mesh visible" % [leg_name, seg])
	for mesh: Node in mech.find_children("Mesh_*", "MeshInstance3D", true, false):
		assert_false((mesh as MeshInstance3D).visible, "the generated box is hidden, only its collider is used")
	var skeleton := mech.find_children("*", "Skeleton3D", true, false)
	assert_eq(skeleton.size(), 1, "the real skinned model is a child of the body")


func test_stands_at_ride_height() -> void:
	await physics_frames(360)
	var t: Dictionary = mech.call("telemetry")
	assert_eq(t["grounded_legs"], 4)
	assert_lt(mech.linear_velocity.length(), 0.3, "settled")
	assert_lt(absf(t["roll_deg"]), 3.0)
	assert_gt(mech.global_position.y, -2.0, "did not fall through the ground box")


func test_walks_forward_without_falling() -> void:
	await physics_frames(240)
	var start := mech.global_position
	Input.action_press("move_forward", 1.0)
	await physics_frames(600)
	Input.action_release("move_forward")
	await physics_frames(120)
	var moved := mech.global_position - start
	assert_lt(moved.z, -3.0, "walked forward (-z)")
	var t: Dictionary = mech.call("telemetry")
	assert_gt(t["grounded_legs"], 0, "still standing, not tipped over or fallen through")
	assert_lt(absf(t["roll_deg"]), 25.0, "did not tip over")


func test_gun_rises_when_idle_and_levels_off_when_moving() -> void:
	await physics_frames(400)
	assert_gt(mech.get("_gun_bone"), -1, "gun_pitch bone found on the real skeleton")
	assert_lt(mech.linear_velocity.length(), 0.3, "settled before checking the idle gun pose")
	assert_almost_eq(mech.get("_gun_pitch_deg"), 40.0, 1.0, "raised to tuning.juggernaut.gun.idle_deg at rest")
	Input.action_press("move_forward", 1.0)
	await physics_frames(180)
	Input.action_release("move_forward")
	assert_almost_eq(mech.get("_gun_pitch_deg"), 0.0, 1.0, "levels off while moving")


func test_running_uses_the_run_step_timing() -> void:
	Settings.set_value("controls.sprint_mode", "hold", false)
	await physics_frames(60)
	Input.action_press("move_forward", 1.0)
	Input.action_press("sprint", 1.0)
	await physics_frames(60)
	assert_true(bool(mech.get("running")), "sprint held with sprint_mode=hold")
	assert_almost_eq(mech.get("_step_s"), 0.34, 0.001, "tuning.juggernaut.step_run.swing_s while running")
	assert_almost_eq(mech.get("_step_lift_m"), 0.9, 0.001, "tuning.juggernaut.step_run.lift_m while running")
	Input.action_release("sprint")
	await physics_frames(30)
	assert_almost_eq(mech.get("_step_s"), 0.19, 0.001, "back to tuning.juggernaut.step.swing_s walking")


## Lane A2 part 3, ANALYSIS.md's measured run pose ("very low and level, stance wide... does not
## bob", m19's own numbers "drop 0.28 m, -6 deg"): standin_mech.gd's leg loop now casts each leg's
## ground ray from a point offset outward by tuning.juggernaut.run_stance.splay_m while running (not
## just from the hip), and lowers/pitches the rest length by drop_m/pitch_deg, smoothed in over
## transition_s so the transition itself does not read as a bob.
func test_running_widens_and_lowers_the_stance() -> void:
	await physics_frames(360)
	var rest_pitch: float = mech.call("telemetry")["pitch_deg"]
	var rest_y := mech.global_position.y
	Settings.set_value("controls.sprint_mode", "hold", false)
	Input.action_press("move_forward", 1.0)
	Input.action_press("sprint", 1.0)
	await physics_frames(300)
	assert_almost_eq(mech.get("_run_stance"), 1.0, 0.05, "tuning.juggernaut.run_stance faded fully in over transition_s")
	var t: Dictionary = mech.call("telemetry")
	assert_lt(t["pitch_deg"], rest_pitch - 2.0, "nose pitches down while running (run_stance.pitch_deg)")
	assert_lt(mech.global_position.y, rest_y - 0.08, "rides lower while running (run_stance.drop_m)")
	var legs: Array = mech.get("legs")
	var fr: Dictionary = legs.filter(func(l: Dictionary) -> bool: return str(l["name"]) == "fr")[0]
	var hip_x: float = (fr["hip"] as Vector3).x
	var foot_x: float = mech.to_local(fr["hit"]).x
	assert_gt(foot_x - hip_x, 0.3, "front-right foot plants further outboard than the hip while running (run_stance.splay_m)")


## ANALYSIS.md's outward-braced skid turn ("turning at speed: a drift with the legs braced to the
## outside"): the same splay mechanism as the run stance above, added in via tuning.juggernaut.skid
## .brace_out_m while `skidding` is true, independent of whether the mech is also running.
func test_skidding_braces_the_stance_outward() -> void:
	await physics_frames(360)
	Input.action_press("move_forward", 1.0)
	await physics_frames(240)
	Input.action_press("brake", 1.0)
	Input.action_press("turn_right", 1.0)
	await physics_frames(30)
	assert_true(bool(mech.get("skidding")), "brake + hard turn at speed triggers a skid")
	for i in 60:
		await tree.physics_frame
		if not bool(mech.get("skidding")):
			break
	assert_gt(float(mech.get("_skid_brace")), 0.2, "tuning.juggernaut.skid.brace_out_m faded in while skidding")
	var legs: Array = mech.get("legs")
	var fr: Dictionary = legs.filter(func(l: Dictionary) -> bool: return str(l["name"]) == "fr")[0]
	var hip_x: float = (fr["hip"] as Vector3).x
	var foot_x: float = mech.to_local(fr["hit"]).x
	assert_gt(foot_x - hip_x, 0.3, "front-right foot plants further outboard than the hip while skidding")


func test_cockpit_camera_uses_the_real_socket() -> void:
	await physics_frames(30)
	var cam := Camera3D.new()
	cam.set_script(load("res://scripts/camera/chase_camera.gd"))
	tree.root.add_child(cam)
	cam.call("follow", mech)
	cam.set("view", "cockpit")
	cam.call("_process", 0.0)
	var eye: Array = (mech.get("def") as Dictionary).get("cameras", {}).get("cockpit")
	assert_not_null(eye, "juggernaut_m2 has a generated cockpit socket")
	var expected: Vector3 = mech.global_transform * Vector3(eye[0], eye[1], eye[2])
	assert_almost_eq(cam.global_position, expected, 0.3, "camera sits at model2's real cockpit socket, not a placeholder")
	cam.free()


func test_feet_stay_planted_while_grounded() -> void:
	await physics_frames(360)
	var planted: Array = []
	for leg: Dictionary in (mech.get("legs") as Array):
		planted.append(leg["planted"])
	await physics_frames(120)
	var legs: Array = mech.get("legs")
	for i in legs.size():
		var leg: Dictionary = legs[i]
		if bool(leg["contact"]) and float(leg["step_t"]) < 0.0:
			var drift: float = (planted[i] as Vector3).distance_to(leg["planted"])
			assert_lt(drift, 0.05, "a planted, non-stepping foot does not slip while idle")
