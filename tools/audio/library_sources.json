{
  "_about": "Where the downloaded sound library comes from (lane B4 part 2). tools/audio/fetch_library.py reads this, downloads into ~/Forge/shared/sound_library/<source>/ and writes library.json there (one entry per file: id, title, tags, licence, path, seconds). Adding a source or a category is one line here. Licences: Kenney packs and OpenGameArt items (searched with the CC0 filter, and each page checked for CC0) are CC0; Mixkit sound effects are under the Mixkit Sound Effects Free License (use in games, no attribution, but not redistributed as loose files).",
  "library_dir": "~/Forge/shared/sound_library",
  "mixkit": {
    "licence": "Mixkit Sound Effects Free License",
    "url": "https://mixkit.co/free-sound-effects/{tag}/?page={page}",
    "file": "https://assets.mixkit.co/active_storage/sfx/{id}/{id}.wav",
    "tags": [
      "explosion",
      "bomb",
      "boom",
      "gun",
      "shot",
      "war",
      "warfare",
      "battle",
      "battle-ambience",
      "tanks",
      "impact",
      "hit",
      "metal",
      "crash",
      "thud",
      "stomp",
      "drop",
      "rock",
      "glass",
      "robot",
      "engine",
      "high-tech",
      "sci-fi",
      "electricity",
      "tools",
      "construction",
      "truck",
      "rocket",
      "wind",
      "storm",
      "ambience",
      "desert",
      "mountain",
      "footsteps",
      "walk",
      "whoosh",
      "swoosh",
      "click",
      "interface",
      "radio",
      "static",
      "alarm",
      "beep"
    ]
  },
  "kenney": {
    "licence": "CC0",
    "page": "https://kenney.nl/assets/{pack}",
    "packs": [
      "impact-sounds",
      "sci-fi-sounds",
      "interface-sounds",
      "ui-audio",
      "digital-audio",
      "rpg-audio"
    ]
  },
  "opengameart": {
    "licence": "CC0",
    "search": "https://opengameart.org/art-search-advanced?keys={q}&field_art_type_tid%5B%5D=13&field_art_license_tid%5B%5D=4&sort_by=count&sort_order=DESC&page={page}",
    "pages": 1,
    "max_mb_per_item": 25,
    "queries": [
      "cannon",
      "gunshot",
      "tank",
      "artillery",
      "metal impact",
      "debris",
      "footstep",
      "stomp",
      "robot",
