extends "res://scripts/mech/standin_mech.gd"
## The real Juggernaut Model 2 (lane B1's export) on lane A1's per-part-box gait and physics
## (springs, drive, turn, skid, charge jump, two-bone leg IK) unchanged: real hip positions, leg
## segment lengths, mass and centre of mass come from data/mechs.json + data/parts.json (both
## generated by tools/build_juggernaut_data.py from the export), so the walk is tuned against the
## real machine's proportions, not the stand-in's placeholders.
##
## Only the four legs' meshes are swapped for the real skinned ones: the standin's invisible box
## meshes stay as the hitbox and IK reference (every physics tick still writes their transform;
## see standin_mech.gd), and the real thigh/shin/foot meshes are detached from the glb's skeleton
## and follow the same transform plus a fixed rest-pose offset. The chassis and sub-arms are
## locked to the body (no independent traverse, B1.md "locked_bones"), so they stay exactly where
## B1 placed them in the glb. The one exception, per the plan: the gun_pitch bone (unlocked in the
## export, carrying the barrel/receiver/magazine) rises to tuning.juggernaut.gun.idle_deg while
## stationary and levels off while moving, by setting that one bone's pose on the glb's own
## Skeleton3D -- everything else is still the un-posed bind pose.

const DEFAULT_MODEL_SCENE := "res://assets/models/juggernaut/juggernaut_mk2.glb"
const Rams := preload("res://scripts/locomotion/leg_rams.gd")

var _real_mesh: Dictionary = {}  # leg name ("fr"...) -> {"upper"/"lower"/"foot": Node3D}
var _mesh_offset: Dictionary = {}  # leg name -> {"upper"/"lower"/"foot": Transform3D}
var _walk_step_s := 0.19
var _walk_lift_m := 0.85
var _run_step_s := 0.19
var _run_lift_m := 0.85
var _skeleton: Skeleton3D
var _gun_bone := -1
var _gun_axis := Vector3.RIGHT
var _gun_rest_rot := Quaternion.IDENTITY
var _rams: Array = []  # [{"node", "rest", "on", "mount", "aim", "leg"}] (lane A2 part 5)
var _shine_mats: Array = []  # [{"mat": BaseMaterial3D copy, "metallic": exported, "specular": exported}]
var _gun_pitch_deg := 0.0
var parked := false  # gun raised by the park key
var _gun_idle_deg := 0.0
var _gun_transition_deg_s := 70.0


func setup(id: String, mech_def: Dictionary, leg_list: Array, info: Dictionary, acts: Array) -> void:
	super.setup(id, mech_def, leg_list, info, acts)
	_t = Registry.deep_merge(_t, Registry.tune("juggernaut", {}))
	_apply_tuning()
	for mesh: Node in find_children("Mesh_*", "MeshInstance3D", true, false):
		(mesh as MeshInstance3D).visible = false
	for leg: Dictionary in legs:
		(leg["upper_mesh"] as MeshInstance3D).visible = false
		(leg["lower_mesh"] as MeshInstance3D).visible = false
		(leg["foot_mesh"] as MeshInstance3D).visible = false
	var model_scene := str(mech_def.get("model", DEFAULT_MODEL_SCENE))
	if not ResourceLoader.exists(model_scene):
		push_warning("juggernaut_mech: %s not synced yet (tools/sync_models.py juggernaut)" % model_scene)
		return
	var skin := (load(model_scene) as PackedScene).instantiate() as Node3D
	# The glb's origin is the ground under the model; this body's origin is the model's "body" bone
	# (mechs.json model_origin, chest height), the frame every collider, hip and socket is in. Found
	# in lane A2 part 4 by the hull-on-mesh test: without this shift the whole visible model sat
	# 1.41 m above its own colliders.
	var o: Array = mech_def.get("model_origin", [0, 0, 0])
	skin.position = -Vector3(float(o[0]), float(o[1]), float(o[2]))
	add_child(skin)
	_wire_shine(skin)
	Emblem.attach(self, def.get("sockets", {}), Settings.get_s("mech.emblem"))
	FootDust.attach(self)
	GrimeBuildup.attach(self)
	_wire_real_legs(skin)
	_wire_rams(skin)
	Settings.changed.connect(_on_setting_changed)
	_wire_gun(skin)


## Emerson's play-testing controls, Settings > Gameplay > Juggernaut (live, see _apply_stance).
func _read_stance() -> void:
	_leg_scale = Settings.get_f("mech.leg_length")
	_lift = Settings.get_f("mech.ride_lift_m")
	_spread = Settings.get_f("mech.foot_spread")


func _on_setting_changed(key: String, value: Variant) -> void:
	if key == "mech.shine":
		_apply_shine()
	elif key == "mech.finish":
		_apply_finish()
	elif key == "mech.emblem":
		Emblem.attach(self, def.get("sockets", {}), str(value))
	elif key.begins_with("mech."):
		_read_stance()
		_apply_stance()


## A per-mech copy of every metal material on the model, so "Metal shine" (mech.shine) can dull or
## brighten the finish live: metallic and specular scale with it; 100% is the finish B1 exported.
## The copies are made per height band (Finish.band_copies), so grime can rise from the feet.
func _wire_shine(skin: Node3D) -> void:
	var metal := func(m: StandardMaterial3D) -> bool: return m.metallic > 0.0
	for dup: StandardMaterial3D in Finish.band_copies(skin, {}, metal):
		_shine_mats.append({"mat": dup, "metallic": dup.metallic, "specular": dup.metallic_specular})
	_apply_finish()


## Paint and wear from data/finishes.json (lane B4) on the same copies; shine then scales it.
func _apply_finish() -> void:
	var mats: Array = []
	for m: Dictionary in _shine_mats:
		mats.append(m["mat"])
	var base := Finish.apply_to(mats, Settings.get_s("mech.finish"))
	for m: Dictionary in _shine_mats:
		if base.has(m["mat"]):
			m["metallic"] = base[m["mat"]]
	_apply_shine()


func _apply_shine() -> void:
	var s := Settings.get_f("mech.shine")
	for m: Dictionary in _shine_mats:
		var mat: BaseMaterial3D = m["mat"]
		mat.metallic = float(m["metallic"]) * s
		mat.metallic_specular = float(m["specular"]) * lerpf(0.4, 1.0, s)


## Reads "step_run" (used instead of "step" while sprinting) and "gun" (idle rise) on top of the
## base class's "step" (walk timing), both from the "juggernaut" tuning block merged in setup().
func _apply_tuning() -> void:
	super._apply_tuning()
	_walk_step_s = _step_s
	_walk_lift_m = _step_lift_m
	var run: Dictionary = _t.get("step_run", {})
	_run_step_s = float(run.get("swing_s", _walk_step_s))
	_run_lift_m = float(run.get("lift_m", _walk_lift_m))
	var gun: Dictionary = _t.get("gun", {})
	_gun_idle_deg = float(gun.get("idle_deg", 0.0))
	_gun_transition_deg_s = float(gun.get("transition_deg_s", 70.0))


## Finds the gun_pitch bone the export's gun_elevation actuator drives (unlocked; carries the
## barrel/receiver/magazine) and its rotation axis, read from the bone's own rest pose so it is
## correct in Godot's import space regardless of the export json's axis convention.
func _wire_gun(skin: Node) -> void:
	_skeleton = skin.find_children("*", "Skeleton3D", true, false)[0] as Skeleton3D
	if _skeleton == null:
		return
	_gun_bone = _skeleton.find_bone("gun_pitch")
	if _gun_bone < 0:
		push_warning("juggernaut_mech: no gun_pitch bone, idle gun rise disabled")
		return
	# Godot 4 bone poses are the bone's whole local transform, not an offset from its rest pose, so
	# the pitch goes on top of the rest rotation, about the body's side-to-side axis (skeleton X: the
	# glb is not rotated against the body) expressed in the parent bone's frame. Setting the pitch
	# alone threw away the rest rotation and stood the barrel nearly upright (lane A2 part 4, from
	# Emerson's "the gun looks too long"; tests/test_juggernaut.gd measures the barrel's real line).
	_gun_rest_rot = _skeleton.get_bone_rest(_gun_bone).basis.get_rotation_quaternion()
	var parent := _skeleton.get_bone_parent(_gun_bone)
	var parent_basis := _skeleton.get_bone_global_rest(parent).basis if parent >= 0 else Basis.IDENTITY
	_gun_axis = (parent_basis.inverse() * Vector3.RIGHT).normalized()


## Detach each leg's real thigh/shin/foot mesh from the glb's (never re-posed) skeleton and
## record its rest-pose offset from the same LegIK segment transform standin_mech drives, so it
## can be replayed on top of the physics every tick. MechBuilder.build() calls setup() before the
## mech is added to the scene tree, so Node3D.global_transform is not valid yet (Godot requires
## is_inside_tree()): the offset is built by hand, walking local `transform`s up to `self`.
func _wire_real_legs(skin: Node) -> void:
	for leg: Dictionary in legs:
		var leg_name: String = leg["name"]
		var suffix := leg_name.to_upper()
		var thigh := skin.find_child("JG2_thigh_%s" % suffix, true, false) as Node3D
		var shin := skin.find_child("JG2_shin_%s" % suffix, true, false) as Node3D
		var foot := skin.find_child("JG2_foot_%s" % suffix, true, false) as Node3D
		if thigh == null or shin == null or foot == null:
			push_warning("juggernaut_mech: no real mesh for leg %s, keeping the box" % leg_name)
			continue
		# The same rest frames MechBuilder gave the hitboxes and their hulls, so the visible leg and
		# its hitbox stay on each other whatever the IK does.
		var rest := MechBuilder.rest_segments(leg)
		_mesh_offset[leg_name] = {
			"upper": (rest["upper"] as Transform3D).affine_inverse() * _rest_transform_to(thigh, self),
			"lower": (rest["lower"] as Transform3D).affine_inverse() * _rest_transform_to(shin, self),
			"foot": (rest["foot"] as Transform3D).affine_inverse() * _rest_transform_to(foot, self),
		}
		thigh.owner = null
		shin.owner = null
		foot.owner = null
		thigh.reparent(self, false)
		shin.reparent(self, false)
		foot.reparent(self, false)
		_real_mesh[leg_name] = {"upper": thigh, "lower": shin, "foot": foot}


## `node`'s transform relative to `ancestor`, composed from each Node3D's own local `transform`
## (never the SceneTree-cached global_transform, which needs is_inside_tree()).
static func _rest_transform_to(node: Node3D, ancestor: Node) -> Transform3D:
	var xf := Transform3D.IDENTITY
	var n: Node = node
	while n != null and n != ancestor:
		if n is Node3D:
			xf = (n as Node3D).transform * xf
		n = n.get_parent()
	return xf


func _physics_process(delta: float) -> void:
	# running is set by standin_mech's _integrate_forces, which runs before _physics_process in
	# the same physics tick, so it already reflects this tick's input by the time we read it here.
	_step_s = _run_step_s if running else _walk_step_s
	_step_lift_m = _run_lift_m if running else _walk_lift_m
	super._physics_process(delta)
	for leg: Dictionary in legs:
		var leg_name: String = leg["name"]
		if not _real_mesh.has(leg_name):
			continue
		var mesh: Dictionary = _real_mesh[leg_name]
		var offset: Dictionary = _mesh_offset[leg_name]
		(mesh["upper"] as Node3D).transform = (leg["upper_mesh"] as Node3D).transform * (offset["upper"] as Transform3D)
		(mesh["lower"] as Node3D).transform = (leg["lower_mesh"] as Node3D).transform * (offset["lower"] as Transform3D)
		(mesh["foot"] as Node3D).transform = (leg["foot_mesh"] as Node3D).transform * (offset["foot"] as Transform3D)
	_update_gun_pitch(delta)
	_update_rams()


## Park: the "park" action (P) raises the gun to its parked angle and pressing it again lowers it.
## Emerson, 2026-10-01: "park should just be for pressing P, not standing still"; it no longer
## comes on by itself at rest (the old gameplay.gun_idle_raise option is gone), and moving does
## not lower it. The gun is otherwise fixed to the body and never tracks anything.
func toggle_park() -> void:
	parked = not parked


func _update_gun_pitch(delta: float) -> void:
	if _gun_bone < 0:
		return
	if is_player and not Game.is_paused() and Input.is_action_just_pressed("park"):
		toggle_park()
	var target := _gun_idle_deg if parked else 0.0
	_gun_pitch_deg = move_toward(_gun_pitch_deg, target, _gun_transition_deg_s * delta)
	_skeleton.set_bone_pose_rotation(_gun_bone, Quaternion(_gun_axis, deg_to_rad(_gun_pitch_deg)) * _gun_rest_rot)


## Detach each leg's ram parts (mechs.json legs.<leg>.rams) from the never-posed skeleton, as the
## legs are, and remember their rest transforms; _update_rams() keeps them on their mounts.
func _wire_rams(skin: Node) -> void:
	for leg: Dictionary in legs:
		leg["rest_frames"] = MechBuilder.rest_segments(leg)
		var leg_def: Dictionary = def.get("legs", {}).get(leg["name"], {})
		for ram: Dictionary in leg_def.get("rams", []):
			var node := skin.find_child(str(ram["part"]).replace(".", "_"), true, false) as Node3D
			if node == null:
				continue
			var rest := _rest_transform_to(node, self)
			node.owner = null
			node.reparent(self, false)
			node.transform = rest
			var m: Array = ram["mount"]
			var a: Array = ram["aim"]
			_rams.append(
				{
					"node": node,
					"rest": rest,
					"on": str(ram["on"]),
					"mount": Vector3(float(m[0]), float(m[1]), float(m[2])),
					"aim": Vector3(float(a[0]), float(a[1]), float(a[2])),
					"leg": leg,
				}
			)


func _update_rams() -> void:
	for r: Dictionary in _rams:
		var leg: Dictionary = r["leg"]
		var frames: Dictionary = leg["rest_frames"]
		var on := str(r["on"])
		var other := "lower" if on == "upper" else "upper"
		var carry: Transform3D = (leg[on + "_hitbox"] as Node3D).transform * (frames[on] as Transform3D).affine_inverse()
		var carry_scaled: Transform3D = (leg[on + "_mesh"] as Node3D).transform * (frames[on] as Transform3D).affine_inverse()
		var other_scaled: Transform3D = (leg[other + "_mesh"] as Node3D).transform * (frames[other] as Transform3D).affine_inverse()
		(r["node"] as Node3D).transform = Rams.pose(r["rest"], carry, carry_scaled, r["mount"], r["aim"], other_scaled * (r["aim"] as Vector3))
